---
import PageIntro from '../../components/PageIntro.astro';
import QuoteCta from '../../components/QuoteCta.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SERVICES } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Upholstery Services in Matthews & Charlotte, NC"
  description="Explore automotive, marine, furniture, and commercial upholstery services from Modern Atlantic Upholstery in Matthews, North Carolina."
>
  <PageIntro
    eyebrow="Our services"
    title="Upholstery for vehicles, boats, furniture, and commercial spaces."
    lede="Modern Atlantic handles a broad range of upholstery projects from its Matthews service center. Choose the category closest to your project, then send us the details so we can understand what you need."
    image="/legacy-repo/Commercial.jpg"
    imageAlt="Completed upholstery project by Modern Atlantic Upholstery"
  />

  <section class="section section-paper">
    <div class="container service-grid">
      {SERVICES.map((service) => (
        <ServiceCard
          title={service.name}
          description={service.short}
          href={service.href}
          image={service.image}
          imageAlt={`Modern Atlantic ${service.name.toLowerCase()} project`}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container process-grid">
      <div>
        <p class="eyebrow">How to start</p>
        <h2>A useful quote starts with useful context.</h2>
      </div>
      <ol class="process-list">
        <li><span>01</span><div><h3>Show us the project</h3><p>Send a few clear photos and tell us what the item, vehicle, or space is.</p></div></li>
        <li><span>02</span><div><h3>Tell us what you want to change</h3><p>Describe the condition, the look you are after, and any details that matter to you.</p></div></li>
        <li><span>03</span><div><h3>Choose how to continue</h3><p>Call, email, or start the quote request and we will use the information to move the conversation forward.</p></div></li>
      </ol>
    </div>
  </section>

  <QuoteCta />
</BaseLayout>
