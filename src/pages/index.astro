---
import { SERVICES, SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Upholstery Shop in Matthews & Charlotte, NC"
  description="Automotive, marine, furniture, and commercial upholstery from Modern Atlantic Upholstery in Matthews, serving the Charlotte area. Explore real work or request a quote."
>
  <section class="premium-hero">
    <div class="premium-hero-media" aria-hidden="true">
      <img src="/legacy-repo/moto.jpg" alt="" decoding="async" />
    </div>
    <div class="premium-hero-shade"></div>

    <div class="container premium-hero-inner">
      <div class="premium-hero-copy">
        <p class="premium-kicker">Handcrafted elegance in every stitch</p>
        <h1>Custom upholstery for a higher standard.</h1>
        <p class="premium-lede">
          Automotive, marine, furniture, and commercial upholstery crafted in Matthews
          for clients across the Charlotte area.
        </p>

        <div class="premium-actions">
          <a class="premium-button premium-button-gold" href="/contact/">
            Get a quote <span aria-hidden="true">→</span>
          </a>
          <a class="premium-button premium-button-glass" href="/portfolio/">
            View our work
          </a>
        </div>
      </div>

      <div class="premium-proof" aria-label="Modern Atlantic highlights">
        <div>
          <strong>Nearly 20</strong>
          <span>years of upholstery craft</span>
        </div>
        <div>
          <strong>{SITE.google.rating} ★</strong>
          <span>{SITE.google.reviewCount} Google reviews</span>
        </div>
        <div>
          <strong>Matthews, NC</strong>
          <span>serving Charlotte</span>
        </div>
      </div>
    </div>
  </section>

  <section class="premium-services">
    <div class="container">
      <div class="premium-section-heading">
        <div>
          <p class="premium-kicker premium-kicker-dark">Our services</p>
          <h2>Four worlds.<br />One standard.</h2>
        </div>
        <p>
          Different environments demand different materials and techniques.
          The standard of finish should never change.
        </p>
      </div>

      <div class="premium-service-grid">
        {SERVICES.map((service, index) => (
          <a class="premium-service-card" href={service.href}>
            <img
              src={service.image}
              alt={`Modern Atlantic ${service.name.toLowerCase()} project`}
              loading={index < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="premium-service-shade"></span>
            <span class="premium-service-index">0{index + 1}</span>
            <span class="premium-service-label">
              <strong>{service.name.replace(' Upholstery', '')}</strong>
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="premium-craft">
    <div class="container premium-craft-grid">
      <div class="premium-craft-copy">
        <p class="premium-kicker">The craftsmanship</p>
        <h2>More than upholstery.<br />A higher standard of finish.</h2>
        <p>
          Victor Terzi has spent nearly two decades working with upholstery, beginning
          with automotive interiors and expanding into furniture, marine, and custom work.
          Modern Atlantic is built around that hands-on experience: understand the piece,
          choose the right approach, and finish it with care.
        </p>
        <a class="premium-text-link" href="/about-us/">
          Meet Victor Terzi <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="premium-craft-image">
        <img
          src="/real-work/furniture-tufted-chair-ottoman.webp"
          alt="Tufted chair and ottoman upholstery completed by Modern Atlantic Upholstery"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <section class="premium-work">
    <div class="container">
      <div class="premium-work-heading">
        <div>
          <p class="premium-kicker premium-kicker-dark">Real work</p>
          <h2>The proof is in the details.</h2>
        </div>
        <a class="premium-text-link premium-text-link-dark" href="/portfolio/">
          Explore the portfolio <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="premium-work-grid">
        <figure class="premium-work-main">
          <img src="/legacy-repo/bout2.jpg" alt="Real marine upholstery project by Modern Atlantic Upholstery" loading="lazy" decoding="async" />
          <figcaption>Marine</figcaption>
        </figure>
        <figure>
          <img src="/real-work/furniture-tufted-chair-ottoman.webp" alt="Real tufted furniture upholstery project by Modern Atlantic Upholstery" loading="lazy" decoding="async" />
          <figcaption>Furniture</figcaption>
        </figure>
        <figure>
          <img src="/legacy-repo/Commercial.jpg" alt="Real commercial upholstery project by Modern Atlantic Upholstery" loading="lazy" decoding="async" />
          <figcaption>Commercial</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="premium-quote">
    <div class="container premium-quote-grid">
      <div>
        <p class="premium-kicker">Start with a photo</p>
        <h2>Show us what you want to transform.</h2>
      </div>
      <div class="premium-quote-actions">
        <p>
          Send the project details and photos. We will start with the piece, the goal,
          and the finish you have in mind.
        </p>
        <a class="premium-button premium-button-gold" href="/contact/">
          Request a quote <span aria-hidden="true">→</span>
        </a>
        <a class="premium-contact-line" href={`tel:${SITE.phoneHref}`}>
          Call {SITE.phoneDisplay}
        </a>
      </div>
    </div>
  </section>

  <a class="premium-mobile-cta" href="/contact/" aria-label="Request a quote and send project photos">
    <span class="premium-mobile-cta-icon" aria-hidden="true">⌁</span>
    <span><small>Want a quote?</small><strong>Send us a photo of your project.</strong></span>
    <span aria-hidden="true">→</span>
  </a>
</BaseLayout>
