---
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = [
  { src: '/legacy-repo/bout.jpg', label: 'Marine', alt: 'Completed marine upholstery project' },
  { src: '/legacy-repo/bout2.jpg', label: 'Marine', alt: 'Completed boat upholstery project' },
  { src: '/legacy-repo/moto.jpg', label: 'Motorcycle', alt: 'Completed motorcycle upholstery project' },
  { src: '/legacy-repo/sofas.jpg', label: 'Furniture', alt: 'Completed sofa upholstery project' },
  { src: '/legacy-repo/longchair.jpg', label: 'Furniture', alt: 'Completed chair upholstery project' },
  { src: '/legacy-repo/table_chairs.jpg', label: 'Furniture', alt: 'Completed dining chair upholstery project' },
  { src: '/legacy-repo/Commercial.jpg', label: 'Commercial', alt: 'Completed commercial upholstery project' },
  { src: '/real-work/furniture-tufted-chair-ottoman.webp', label: 'Furniture', alt: 'Tufted chair and ottoman upholstery project completed by Modern Atlantic Upholstery' },
];
---

<BaseLayout
  title="Upholstery Portfolio"
  description="View real automotive, marine, furniture, and commercial upholstery work from Modern Atlantic Upholstery in Matthews, North Carolina."
  image="/legacy-repo/bout2.jpg"
>
  <section class="premium-portfolio-hero">
    <div class="container premium-portfolio-heading">
      <div>
        <p class="premium-kicker premium-kicker-dark">Real work</p>
        <h1>The work is the proof.</h1>
      </div>
      <p>
        Every image below is real Modern Atlantic work — marine, vehicle, furniture,
        and commercial upholstery completed by the shop.
      </p>
    </div>
  </section>

  <section class="premium-portfolio">
    <div class="container premium-portfolio-grid">
      {projects.map((project, index) => (
        <figure class:list={['premium-portfolio-item', index === 0 && 'premium-portfolio-featured', index === 4 && 'premium-portfolio-tall']}>
          <img src={project.src} alt={project.alt} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
          <figcaption><span>{project.label}</span><span aria-hidden="true">↗</span></figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
