---
import { SITE } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Contact Modern Atlantic Upholstery in Matthews, North Carolina by phone or email."
>
  <section class="page-shell">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch.</h1>
      <p class="lede">
        The production contact route is preserved. A structured request-a-quote
        workflow with project details and photo uploads is planned for a later
        mission; no nonfunctional form is shipped in this foundation.
      </p>
      <div class="grid services section">
        <article class="card">
          <h2>Call</h2>
          <p><a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a></p>
        </article>
        <article class="card">
          <h2>Email</h2>
          <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        </article>
        <article class="card">
          <h2>Service Center</h2>
          <p>{SITE.address.street}</p>
          <p>
            {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
