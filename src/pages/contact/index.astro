---
import { SITE } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`,
)}`;
const emailHref = `mailto:${SITE.email}?subject=${encodeURIComponent('Modern Atlantic Upholstery quote request')}`;
---

<BaseLayout
  title="Request an Upholstery Quote"
  description="Contact Modern Atlantic Upholstery in Matthews, NC. Call, email project photos, get directions, or prepare a quote request for automotive, marine, furniture, or commercial upholstery."
>
  <section class="premium-contact-hero">
    <div class="container premium-contact-hero-grid">
      <div>
        <p class="premium-kicker">Request a quote</p>
        <h1>Start with the piece.<br />Then the possibilities.</h1>
        <p class="premium-page-lede">
          Send photos, tell us what you want to change, and give us enough context to understand the project.
        </p>
      </div>
      <div class="premium-contact-actions">
        <a href={`tel:${SITE.phoneHref}`}><small>Call the shop</small><strong>{SITE.phoneDisplay}</strong><span aria-hidden="true">→</span></a>
        <a href={emailHref}><small>Email photos</small><strong>{SITE.email}</strong><span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="premium-contact-prep">
    <div class="container premium-contact-prep-grid">
      <div>
        <p class="premium-kicker premium-kicker-dark">What to send</p>
        <h2>Four details make the first conversation better.</h2>
      </div>
      <ol>
        <li><span>01</span><div><strong>Project type</strong><p>Automotive, marine, furniture, commercial, or something custom.</p></div></li>
        <li><span>02</span><div><strong>Clear photos</strong><p>Show the full piece or interior and the areas you want repaired or changed.</p></div></li>
        <li><span>03</span><div><strong>Your goal</strong><p>Restoration, replacement, a new look, improved comfort, or custom work.</p></div></li>
        <li><span>04</span><div><strong>Best contact</strong><p>Phone or email — whichever is easiest for continuing the conversation.</p></div></li>
      </ol>
    </div>
  </section>


  <section class="premium-quote-planner" id="quote-planner">
    <div class="container premium-quote-planner-grid">
      <div class="premium-quote-planner-copy">
        <p class="premium-kicker premium-kicker-dark">Quote planner</p>
        <h2>Give us the useful details first.</h2>
        <p>
          This short form prepares an email with the project basics. When your email app opens,
          attach the project photos before sending.
        </p>
      </div>

      <form class="premium-quote-form" id="quote-email-form">
        <div class="premium-form-row">
          <label>
            <span>Name</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label>
            <span>Phone</span>
            <input name="phone" type="tel" autocomplete="tel" required />
          </label>
        </div>

        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>

        <label>
          <span>What do you need?</span>
          <select name="projectType" required>
            <option value="" selected disabled>Select project type</option>
            <option>Automotive upholstery</option>
            <option>Marine upholstery</option>
            <option>Furniture upholstery</option>
            <option>Commercial upholstery</option>
            <option>Other / custom work</option>
          </select>
        </label>

        <label>
          <span>Project details</span>
          <textarea name="details" rows="6" placeholder="What is the piece, what condition is it in, and what would you like to change?" required></textarea>
        </label>

        <fieldset>
          <legend>Preferred contact</legend>
          <div class="premium-radio-row">
            <label><input type="radio" name="preferred" value="Call" checked /> Call</label>
            <label><input type="radio" name="preferred" value="Text" /> Text</label>
            <label><input type="radio" name="preferred" value="Email" /> Email</label>
          </div>
        </fieldset>

        <button class="premium-button premium-button-gold premium-form-submit" type="submit">
          Prepare quote email <span aria-hidden="true">→</span>
        </button>
        <p class="premium-form-note">No information is stored on this preview. Your email app will open with these details prefilled.</p>
      </form>
    </div>
  </section>

  <section class="premium-contact-details">
    <div class="container premium-contact-detail-grid">
      <article>
        <p class="premium-kicker premium-kicker-dark">Service center</p>
        <h2>{SITE.address.street}<br />{SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}</h2>
        <a class="premium-text-link premium-text-link-dark" href={mapsHref} rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <p class="premium-kicker premium-kicker-dark">Direct contact</p>
        <a class="premium-contact-big" href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a>
        <a class="premium-contact-big premium-contact-email" href={emailHref}>{SITE.email}</a>
      </article>
    </div>
  </section>

  <section class="premium-contact-photo">
    <div class="container premium-contact-photo-inner">
      <div>
        <p class="premium-kicker">The easiest first step</p>
        <h2>Send us a photo of your project.</h2>
        <p>Photos quickly show scale, condition, material, and the details that are hard to explain over the phone.</p>
      </div>
      <a class="premium-button premium-button-gold" href={emailHref}>Email project photos <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <script is:inline>
    (() => {
      const form = document.getElementById('quote-email-form');
      if (!form) return;

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const subject = 'Quote request — ' + (data.get('projectType') || 'Upholstery project');
        const body = [
          'Modern Atlantic Upholstery quote request',
          '',
          'Name: ' + (data.get('name') || ''),
          'Phone: ' + (data.get('phone') || ''),
          'Email: ' + (data.get('email') || ''),
          'Project type: ' + (data.get('projectType') || ''),
          'Preferred contact: ' + (data.get('preferred') || ''),
          '',
          'Project details:',
          String(data.get('details') || ''),
          '',
          'Please attach project photos before sending this email.',
        ].join('\n');

        window.location.href = 'mailto:info@maupholsteryclt.com?subject='
          + encodeURIComponent(subject)
          + '&body='
          + encodeURIComponent(body);
      });
    })();
  </script>
</BaseLayout>
