---
import { SITE } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Victor Terzi',
  jobTitle: 'Owner and Upholsterer',
  worksFor: {
    '@type': 'LocalBusiness',
    '@id': `${SITE.url}/#business`,
    name: SITE.name,
  },
  knowsAbout: ['Automotive upholstery', 'Marine upholstery', 'Furniture upholstery', 'Commercial upholstery'],
};
---

<BaseLayout
  title="About Victor Terzi & Modern Atlantic Upholstery"
  description="Meet Victor Terzi and learn about the automotive roots, restoration mindset, and hands-on upholstery craft behind Modern Atlantic Upholstery in Matthews, NC."
>
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <section class="premium-about-hero">
    <div class="container premium-about-hero-grid">
      <div class="premium-about-copy">
        <p class="premium-kicker">Meet the owner</p>
        <h1>Victor Terzi.</h1>
        <p class="premium-page-lede">
          Nearly two decades of hands-on upholstery, from automotive interiors to furniture,
          marine, commercial, and custom work.
        </p>
        <aside class="premium-about-recognition" aria-label="Victor's automotive upholstery recognition">
          <span class="premium-about-recognition-label">A career highlight</span>
          <p>
            Victor's craftsmanship helped <strong>two cars win first place</strong>
            in a European interior design competition.
          </p>
        </aside>
        <div class="premium-about-meta">
          <div><strong>Nearly 20</strong><span>years in upholstery</span></div>
          <div><strong>Matthews</strong><span>North Carolina</span></div>
        </div>
      </div>
      <div class="premium-about-visual">
        <figure class="premium-about-image">
          <img
            src="/brand/generated/victor-craft-editorial.avif"
            alt="Editorial illustration of upholstery craftsmanship, with hands stitching leather"
            width="480"
            height="784"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <p class="premium-about-visual-credit">Editorial illustration of the craft</p>
      </div>
    </div>
  </section>

  <section class="premium-about-story">
    <div class="container premium-about-story-grid">
      <div>
        <p class="premium-kicker premium-kicker-dark">The story</p>
        <h2>Automotive roots.<br />A restoration mindset.</h2>
      </div>
      <div class="premium-about-prose">
        <p>
          Victor started in automotive upholstery, where the smallest alignment, seam, and
          finish can change how an entire interior feels. That early discipline became the
          foundation for Modern Atlantic.
        </p>
        <p>
          The work later expanded into furniture and other custom upholstery projects. What
          connects every category is the transformation: taking something worn, dated, damaged,
          or simply no longer right for its owner and giving it a useful next chapter.
        </p>
        <p>
          Today, Modern Atlantic works from Matthews and serves the Charlotte area with a direct,
          project-first approach. The piece comes first. Then the materials, technique, and finish
          follow from what the project actually needs.
        </p>
      </div>
    </div>
  </section>

  <section class="premium-values">
    <div class="container premium-values-grid">
      <article><span>01</span><h3>Look closely.</h3><p>Condition, proportion, surrounding interior, and intended use all matter before choosing a direction.</p></article>
      <article><span>02</span><h3>Respect the piece.</h3><p>Good restoration keeps what deserves to stay and changes only what needs to change.</p></article>
      <article><span>03</span><h3>Finish with intention.</h3><p>The goal is not simply new material. It is a finished result that belongs in the space.</p></article>
    </div>
  </section>
</BaseLayout>
