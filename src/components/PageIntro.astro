---
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  image?: string;
  imageAlt?: string;
}

const { eyebrow, title, lede, image, imageAlt = '' } = Astro.props;
---

<section class="page-intro">
  <div class="container page-intro-grid">
    <div class="page-intro-copy">
      <p class="eyebrow eyebrow-light">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede lede-light">{lede}</p>
    </div>
    {
      image && (
        <figure class="page-intro-media">
          <img src={image} alt={imageAlt} decoding="async" />
        </figure>
      )
    }
  </div>
</section>
