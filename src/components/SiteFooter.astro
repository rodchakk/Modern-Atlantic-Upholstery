---
import { SERVICES, SITE } from '../config/site';

const year = new Date().getFullYear();
const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${SITE.address.street}, ${SITE.address.locality}, ${SITE.address.region} ${SITE.address.postalCode}`,
)}`;
---

<footer class="site-footer premium-footer">
  <div class="container premium-footer-intro">
    <div>
      <img class="premium-footer-logo" src="/legacy-repo/MAU-02.png" alt="Modern Atlantic Upholstery" loading="lazy" decoding="async" />
      <p class="premium-footer-tagline">Handcrafted elegance in every stitch.</p>
    </div>
    <div class="premium-footer-cta">
      <p class="premium-kicker">Have a project in mind?</p>
      <h2>Start with a photo.</h2>
      <a class="premium-button premium-button-gold" href="/contact/">Request a quote <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="container premium-footer-grid">
    <div>
      <h3>Services</h3>
      <ul>
        {SERVICES.map((service) => <li><a href={service.href}>{service.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h3>Visit</h3>
      <p>
        <a href={mapsHref} rel="noopener noreferrer">
          {SITE.address.street}<br />
          {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}
        </a>
      </p>
      <p>Serving Matthews and the Charlotte area.</p>
    </div>
    <div>
      <h3>Contact</h3>
      <p><a href={`tel:${SITE.phoneHref}`}>{SITE.phoneDisplay}</a></p>
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </div>
    <div>
      <h3>Follow</h3>
      <p><a href={SITE.social.instagram} rel="noopener noreferrer">Instagram</a></p>
      <p><a href={SITE.social.facebook} rel="noopener noreferrer">Facebook</a></p>
    </div>
  </div>

  <div class="container premium-footer-bottom">
    <p>© {year} {SITE.name}. All rights reserved.</p>
    <p>Website by Minerva Technologies.</p>
  </div>
</footer>
