---
interface Props {
  title: string;
  description: string;
  href: string;
  image: string;
  imageAlt: string;
  kicker?: string;
}

const { title, description, href, image, imageAlt, kicker = 'Service' } = Astro.props;
---

<article class="service-card">
  <a class="service-card-image" href={href} tabindex="-1" aria-hidden="true">
    <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  </a>
  <div class="service-card-body">
    <p class="eyebrow">{kicker}</p>
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="text-link" href={href}>Explore {title.toLowerCase()} <span aria-hidden="true">↗</span></a>
  </div>
</article>
