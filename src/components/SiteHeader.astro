---
import { PRIMARY_NAV, SITE } from '../config/site';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand brand-premium" href="/" aria-label={`${SITE.name} home`}>
      <img class="brand-logo brand-logo-light" src="/legacy-repo/MAU-02.png" alt="Modern Atlantic Upholstery" />
      <img class="brand-logo brand-logo-dark" src="/legacy-repo/MAU-01.png" alt="" aria-hidden="true" />
    </a>

    <nav class="site-nav desktop-nav" aria-label="Primary navigation">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions desktop-actions">
      <a class="header-phone" href={`tel:${SITE.phoneHref}`}>Call {SITE.phoneDisplay}</a>
      <a class="button button-small button-light" href="/contact/">Get a quote</a>
    </div>

    <details class="mobile-menu">
      <summary aria-label="Open navigation">
        <span>Menu</span>
        <span class="menu-lines" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <nav aria-label="Mobile navigation">
        <ul>
          <li><a href="/">Home</a></li>
          {
            PRIMARY_NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="button button-light mobile-quote" href="/contact/">Get a quote</a>
      </nav>
    </details>
  </div>
</header>
